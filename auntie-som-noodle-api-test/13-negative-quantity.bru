meta {
  name: Negative quantity is rejected
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/orders
  body: json
}

headers {
  content-type: application/json
  authorization: Bearer {{accessToken}}
}

body:json {
  { "itemId": 1, "quantity": -1 }
}

tests {
  test("negative quantity cannot create an order", function () {
    expect(res.status).to.equal(400);
    expect(res.body).not.to.have.property("orderId");
  });
}
