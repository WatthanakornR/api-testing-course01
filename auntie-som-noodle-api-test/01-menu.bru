meta {
  name: Menu has the starting stock and prices
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/menu
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body)) {
    const noodles = res.body.find(item => item.id === 1);
    const rice = res.body.find(item => item.id === 2);
    if (noodles && rice) {
      bru.setVar("noodlePrice", noodles.price);
      bru.setVar("riceStock", rice.stock);
    }
  }
}

tests {
  test("menu returns both products with the documented price and stock", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    expect(res.body.find(item => item.id === 1)).to.include({ name: "Tom Yum Noodles", price: 50, stock: 2 });
    expect(res.body.find(item => item.id === 2)).to.include({ name: "Fried Rice", price: 45, stock: 1 });
  });
}
