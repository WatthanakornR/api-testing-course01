meta {
  name: Retrieve created order
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/orders/{{orderId}}
}

tests {
  test("saved order is returned with correct details", function () {
    expect(res.status).to.equal(200);
    expect(res.body.orderId).to.equal(bru.getVar("orderId"));
    expect(res.body.status).to.equal("created");
    expect(res.body.totalPrice).to.equal(Number(bru.getVar("noodlePrice")) * 1);
  });
}
